# Ejecuta python3 scripts/bootstrap_backend.py para generar valores reales.
# No usar los marcadores de este archivo como secretos.
APP_ENV=development
PAYMENT_MODE=sandbox
JWT_SECRET=GENERAR_ALEATORIAMENTE_AL_MENOS_48_CARACTERES
ENCRYPTION_KEY=GENERAR_CLAVE_FERNET
WEBHOOK_SECRET=GENERAR_ALEATORIAMENTE
DATABASE_API_URL=GENERADA_POR_BOOTSTRAP
DATABASE_AUTH_URL=GENERADA_POR_BOOTSTRAP
DATABASE_ADMIN_URL=GENERADA_POR_BOOTSTRAP
DATABASE_BILLING_URL=GENERADA_POR_BOOTSTRAP
DATABASE_WORKER_URL=GENERADA_POR_BOOTSTRAP
WEB_ORIGINS=http://127.0.0.1:8180,http://localhost:8180,http://127.0.0.1:5180,http://localhost:5180
PUBLIC_WEB_URL=http://127.0.0.1:8180
# Publicación de pruebas: APP_ENV=staging, PAYMENT_MODE=sandbox,
# PUBLIC_WEB_URL y WEB_ORIGINS=https://contrata.contupana.pro.
# FORWARDED_ALLOW_IPS=127.0.0.1,IP_GATEWAY_DOCKER
# Confiar solo en el proxy local; nunca usar *.
# DB_HOST=db # Solo Docker; cambia host/puerto sin exponer credenciales.
# DATA_DIR=/app/data
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

# Solo para portales de demostración públicos con PAYMENT_MODE=sandbox (nunca con dinero real).
# ALLOW_PUBLIC_SANDBOX=false
# Swagger/OpenAPI en /api/docs (por defecto activo salvo en producción).
# API_DOCS=
